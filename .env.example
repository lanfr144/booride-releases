# ==============================================================================
# booride-releases - template of the secrets file (dummy values only)
# ==============================================================================
# cp .env.example .env   then put the real values in .env.
# .env is ignored by Git; this .example file is versioned.
# Format: KEY=value, one per line, no quotes needed.
# config.yaml refers to these names as ${DEV_DB_URL}, ${DEV_API_KEY}, ...
# ==============================================================================
DEV_DB_URL=postgresql://DEV_USER:DEV_PASSWORD@localhost:5432/dev_db
DEV_API_KEY=DEV_API_KEY

STAGING_DB_URL=postgresql://STAGING_USER:STAGING_PASSWORD@staging-db:5432/staging_db
STAGING_API_KEY=STAGING_API_KEY

PROD_DB_URL=postgresql://PROD_USER:PROD_PASSWORD@prod-db:5432/prod_db
PROD_API_KEY=PROD_API_KEY
